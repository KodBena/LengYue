# Frontend environment variables.
#
# Variables prefixed with VITE_ are inlined into the frontend bundle
# at build time. This file is committed as documentation — it lists
# every env var the app reads, with its default value.
#
# For local overrides, copy this file to `.env` (which is gitignored)
# and edit freely. Unset variables fall back to the defaults shown here.

# ─── Backend URLs ────────────────────────────────────────────────────────────

# REST API for the Ebisu backend (cards, reviews, forests, documents,
# and static resources at /resources/{name}).
#
# Under the Tauri desktop shell (frontend/src-tauri/) this is
# overridden at runtime: the desktop shell's backend sidecar binds an
# OS-assigned free port and injects it into the webview before any
# page script runs, and src/config/env.ts reads that override in
# preference to this build-time value. See
# .claude/dispatch-reports/wf11-tauri-build.md.
VITE_API_BASE_URL=http://localhost:8764

# Backend host used by the codegen script (`npm run gen:api`).
# Unlike VITE_API_BASE_URL, this variable is never bundled into the SPA —
# it is consumed only at codegen time by the npm script, via shell
# fallback syntax (${GENAPI_BASE_URL:-http://127.0.0.1:8764}).  Set it
# when your backend runs on a non-default host or port.
GENAPI_BASE_URL=http://127.0.0.1:8764

# WebSocket URL for the KataGo analysis middleware. This is the
# out-of-the-box default for fresh installs only — at runtime the user's
# profile setting `settings.katago.url` takes precedence when set. See
# services/analysis-service.ts::connect() for the resolution order.
#
# 1242 is the KataGo WS shim's own default port
# (backend/scripts/katago_ws_shim.py) — the single user-facing port this
# app converges on across every packaging (Docker's ENGINE_WS_URL
# default, the Tauri desktop upstream default, and this plain-dev
# fallback). Run the shim with its defaults and this default just works.
VITE_KATAGO_WS_URL=ws://127.0.0.1:1242

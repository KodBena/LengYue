# Cargo build output — regenerated by `cargo build` / `tauri build`.
/target/

# Tauri's generated capability-schema + mobile scaffolding (regenerated
# by the CLI; not hand-authored).
/gen/

# The frozen sidecar binaries: the backend (built by
# `frontend/src-tauri/scripts/build-sidecar.sh` from `backend/`) and
# the proxy (built by `scripts/build-proxy-sidecar.sh` from a scratch
# KataProxy clone). Both via PyInstaller — per-platform build
# artifacts, not source. See those scripts and the dispatch reports
# ("Backend sidecar" / kataproxy-tauri.md) for the mechanism.
/binaries/*
!/binaries/.gitkeep

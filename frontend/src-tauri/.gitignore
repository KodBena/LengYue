# Cargo build output — regenerated by `cargo build` / `tauri build`.
/target/

# Tauri's generated capability-schema + mobile scaffolding (regenerated
# by the CLI; not hand-authored).
/gen/

# The frozen backend sidecar binary. Built by
# `frontend/src-tauri/scripts/build-sidecar.sh` from `backend/` via
# PyInstaller — a per-platform build artifact, not source. See that
# script and the dispatch report's "Backend sidecar" section.
/binaries/*
!/binaries/.gitkeep

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LengYue",
  "version": "0.1.0",
  "identifier": "lengyue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/lengyue-backend"],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
